# ─────────────────────────────────────────────────────────────────────────────
# BharatBazaar environment
# Copy to .env and fill in real values. Anything prefixed NEXT_PUBLIC_ is sent
# to the browser — never put secrets there.
# ─────────────────────────────────────────────────────────────────────────────

# Database — Neon PostgreSQL (pooled URL for DATABASE_URL, direct URL for migrations)
# Example Neon: postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecom?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ecom?schema=public"

# Store
STORE_NAME="BharatBazaar"
APP_URL="http://localhost:3000"

# Session JWT secret — REQUIRED in production, at least 32 random characters
# e.g. `openssl rand -base64 48`
JWT_SECRET=""

# Admin access — comma separated 10-digit mobile numbers. These users are
# granted the ADMIN role on login and by `npm run db:seed`.
ADMIN_PHONES="9876543210"

# One-click demo logins (Customer 9812345678 / Admin 9876543210, OTP 123456).
# Always on in development; set to "true" only for a staging preview. Never in production.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=""

# ── Firebase Phone Authentication (mobile OTP) ───────────────────────────────
# Client config: Firebase Console → Project settings → Your apps → Web app.
# Enable "Phone" under Authentication → Sign-in method, and add your domain to
# Authorized domains. When these are blank in development a dev-only OTP
# fallback is used (code is printed to the server console).
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Server verification: Firebase Console → Project settings → Service accounts →
# Generate new private key. Paste the JSON (single line) or its base64 encoding.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ── Cloudinary (product image uploads from the admin panel) ──────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Google Maps ──────────────────────────────────────────────────────────────
# Browser key (restrict by HTTP referrer): Maps JavaScript API + Places API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Server key (restrict by IP): Geocoding API — used for "Use my current location".
# Falls back to the browser key if blank.
GOOGLE_MAPS_SERVER_API_KEY=""

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys. Use rzp_test_* keys while testing.
# Enable UPI (intent / collect / QR), Cards, Netbanking and Wallets in the
# dashboard. When blank in development a mock gateway is used (no real money).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Settings → Webhooks → add {APP_URL}/api/checkout/webhook with
# events payment.captured, payment.failed, order.paid. Paste the secret here.
RAZORPAY_WEBHOOK_SECRET=""
